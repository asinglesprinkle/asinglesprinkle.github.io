---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description="Everything I've written, newest first." />
		<style>
			ul {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			li + li {
				margin-top: 2rem;
			}
			.title {
				margin: 0 0 0.2em 0;
				font-size: 1.4rem;
				line-height: 1.2;
			}
			.title a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.title a:hover {
				color: var(--accent);
			}
			.date {
				margin: 0 0 0.4em 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.description {
				margin: 0;
				color: rgb(var(--gray-dark));
			}
			.draft {
				margin-left: 0.5em;
				padding: 0.1em 0.5em;
				border-radius: 4px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray));
				font-size: 0.7rem;
				text-transform: uppercase;
				vertical-align: middle;
			}
			.empty {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog</h1>
			{posts.length === 0 && <p class="empty">Nothing published yet.</p>}
			<ul>
				{
					posts.map((post) => (
						<li>
							<p class="date">
								<FormattedDate date={post.data.pubDate} />
							</p>
							<h2 class="title">
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								{post.data.draft && <span class="draft">Draft</span>}
							</h2>
							<p class="description">{post.data.description}</p>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
