---
import BaseHead from '../../components/BaseHead.astro';
import CategoryChips from '../../components/CategoryChips.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { CATEGORIES } from '../../categories';
import { SITE_TITLE } from '../../consts';
import { getPostsInCategory } from '../../lib/posts';

export async function getStaticPaths() {
	return CATEGORIES.map((category) => ({
		params: { slug: category.slug },
		props: category,
	}));
}

const category = Astro.props;
const posts = await getPostsInCategory(category.slug);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${category.name} | ${SITE_TITLE}`} description={category.description} />
		<style>
			.heading {
				margin-bottom: 2.5rem;
			}
			.heading h1 {
				margin-bottom: 0.2em;
			}
			.heading p {
				margin: 0;
				color: rgb(var(--gray-dark));
			}
			.back {
				display: inline-block;
				margin-bottom: 1.5rem;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			ul {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			li + li {
				margin-top: 2rem;
			}
			.title {
				margin: 0 0 0.2em 0;
				font-size: 1.3rem;
				line-height: 1.2;
			}
			.title a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.title a:hover {
				color: var(--accent);
			}
			.date {
				margin: 0 0 0.3em 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.description {
				margin: 0 0 0.6em 0;
				color: rgb(var(--gray-dark));
			}
			.draft {
				margin-left: 0.5em;
				padding: 0.1em 0.5em;
				border-radius: 4px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray));
				font-size: 0.7rem;
				text-transform: uppercase;
				vertical-align: middle;
			}
			.empty {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="back" href="/">&larr; All topics</a>
			<div class="heading">
				<h1>{category.name}</h1>
				<p>{category.description}</p>
			</div>

			{posts.length === 0 && <p class="empty">Nothing here yet.</p>}
			<ul>
				{
					posts.map((post) => (
						<li>
							<p class="date">
								<FormattedDate date={post.data.pubDate} />
							</p>
							<h2 class="title">
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								{post.data.draft && <span class="draft">Draft</span>}
							</h2>
							<p class="description">{post.data.description}</p>
							<CategoryChips categories={post.data.categories} />
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
